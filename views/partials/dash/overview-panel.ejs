<section class="panel <%= activeTab === 'overview' ? 'active' : '' %>" id="overview">
  <div class="analytics-grid">
    <article class="analytics-card analytics-card-accent">
      <div class="analytics-card-icon"><%- include('../icon', { name: 'order', size: 24 }) %></div>
      <div>
        <span class="analytics-label">Total Orders</span>
        <strong class="analytics-value"><%= stats.orders %></strong>
        <p class="analytics-sub"><%= stats.delivered %> delivered · UGX <%= stats.revenue.toLocaleString() %> revenue</p>
      </div>
    </article>

    <article class="analytics-card">
      <div class="analytics-card-icon"><%- include('../icon', { name: 'document', size: 24 }) %></div>
      <div>
        <span class="analytics-label">Customers</span>
        <strong class="analytics-value"><%= stats.users %></strong>
        <p class="analytics-sub"><%= stats.totalAccounts %> total accounts</p>
      </div>
    </article>

    <article class="analytics-card">
      <div class="analytics-card-icon"><%- include('../icon', { name: 'delivery', size: 24 }) %></div>
      <div>
        <span class="analytics-label">Catalog Items</span>
        <strong class="analytics-value"><%= stats.products %></strong>
        <p class="analytics-sub"><%= stats.categories %> categories</p>
      </div>
    </article>

    <article class="analytics-card analytics-card-warn">
      <div class="analytics-card-icon"><%- include('../icon', { name: 'pending', size: 24 }) %></div>
      <div>
        <span class="analytics-label">Pending Orders</span>
        <strong class="analytics-value"><%= stats.pendingOrders %></strong>
        <p class="analytics-sub"><%= stats.pendingPayments %> payment<%= stats.pendingPayments === 1 ? '' : 's' %> to confirm</p>
      </div>
    </article>

    <article class="analytics-card analytics-card-info">
      <div class="analytics-card-icon"><%- include('../icon', { name: 'delivery', size: 24 }) %></div>
      <div>
        <span class="analytics-label">In Delivery</span>
        <strong class="analytics-value"><%= stats.inDelivery %></strong>
        <p class="analytics-sub">Preparing or out for delivery</p>
      </div>
    </article>

    <article class="analytics-card">
      <div class="analytics-card-icon"><%- include('../icon', { name: 'partner', size: 24 }) %></div>
      <div>
        <span class="analytics-label">Partners</span>
        <strong class="analytics-value"><%= stats.approvedPartners %></strong>
        <p class="analytics-sub"><%= stats.pendingPartners %> application<%= stats.pendingPartners === 1 ? '' : 's' %> pending</p>
      </div>
    </article>
  </div>

  <% if (stats.pendingOrders > 0 || stats.pendingPayments > 0 || stats.pendingPartners > 0) { %>
    <div class="analytics-actions card">
      <h3>Needs your attention</h3>
      <div class="analytics-action-links">
        <% if (stats.pendingPayments > 0) { %>
          <a href="/admin?tab=orders" class="analytics-action-link">
            <strong><%= stats.pendingPayments %></strong>
            <span>Confirm payment<%= stats.pendingPayments > 1 ? 's' : '' %></span>
          </a>
        <% } %>
        <% if (stats.pendingOrders > 0) { %>
          <a href="/admin?tab=orders" class="analytics-action-link">
            <strong><%= stats.pendingOrders %></strong>
            <span>Approve order<%= stats.pendingOrders > 1 ? 's' : '' %></span>
          </a>
        <% } %>
        <% if (stats.pendingPartners > 0) { %>
          <a href="/admin?tab=partners" class="analytics-action-link">
            <strong><%= stats.pendingPartners %></strong>
            <span>Review partner<%= stats.pendingPartners > 1 ? 's' : '' %></span>
          </a>
        <% } %>
      </div>
    </div>
  <% } %>

  <div class="analytics-recent card">
    <div class="panel-head">
      <h2>Recent Orders</h2>
      <a href="/admin?tab=orders" class="btn btn-ghost btn-sm">View all</a>
    </div>
    <% if (orders.length === 0) { %>
      <p class="muted">No orders yet.</p>
    <% } else { %>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th>#</th><th>Item</th><th>Customer</th><th>Total</th><th>Status</th><th>Date</th></tr>
          </thead>
          <tbody>
            <% orders.slice(0, 8).forEach((order) => { %>
              <tr>
                <td><%= order.id %></td>
                <td><strong><%= order.item %></strong></td>
                <td><%= order.userName %></td>
                <td>UGX <%= Number(order.total).toLocaleString() %></td>
                <td><span class="badge badge-<%= order.status %>"><%= statusLabels[order.status] %></span></td>
                <td class="t-muted"><%= new Date(order.createdAt).toLocaleDateString('en-UG') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</section>
