<section class="panel <%= typeof activeTab !== 'undefined' && activeTab === 'products' ? 'active' : '' %>" id="products">
  <div class="panel-head">
    <h2>Products</h2>
    <button type="button" class="btn btn-primary btn-sm" data-open-modal="createProductModal">+ New Product</button>
  </div>

  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr><th>#</th><th>Image</th><th>Name</th><th>Category</th><th>Price (UGX)</th><th class="t-right">Actions</th></tr>
      </thead>
      <tbody>
        <% if (products.length === 0) { %>
          <tr><td colspan="6" class="t-empty">No products yet — add your first one.</td></tr>
        <% } %>
        <% products.forEach((product) => { %>
          <% const cat = categories.find((c) => c.id === product.categoryId); %>
          <tr>
            <td><%= product.id %></td>
            <td><img src="<%= product.image %>" alt="" class="table-thumb" /></td>
            <td><strong><%= product.name %></strong></td>
            <td class="t-muted"><%= cat ? cat.name : '—' %></td>
            <td><%= Number(product.price).toLocaleString() %></td>
            <td class="t-right">
              <details class="action-details table-details">
                <summary class="btn btn-ghost btn-sm">Edit</summary>
                <form method="POST" action="<%= basePath %>/products/<%= product.id %>/update" class="inline-action-form stack-form">
                  <label class="field"><span>Name</span><input type="text" name="name" value="<%= product.name %>" required /></label>
                  <label class="field"><span>Price</span><input type="number" name="price" value="<%= product.price %>" min="0" required /></label>
                  <label class="field"><span>Category</span>
                    <select name="categoryId">
                      <% categories.forEach((c) => { %><option value="<%= c.id %>" <%= c.id === product.categoryId ? 'selected' : '' %>><%= c.name %></option><% }) %>
                    </select>
                  </label>
                  <label class="field"><span>Image URL</span><input type="text" name="image" value="<%= product.image || '' %>" /></label>
                  <label class="field"><span>Description</span><input type="text" name="description" value="<%= product.description || '' %>" /></label>
                  <button type="submit" class="btn btn-primary btn-sm">Save</button>
                </form>
              </details>
              <form method="POST" action="<%= basePath %>/products/<%= product.id %>/delete" class="inline" data-confirm="Delete this product?">
                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<div class="modern-modal" id="createProductModal" hidden>
  <div class="modern-modal-backdrop" data-close-modal></div>
  <div class="modern-modal-card">
    <button type="button" class="modal-close" data-close-modal>&times;</button>
    <form method="POST" action="<%= basePath %>/products">
      <h3>New Product</h3>
      <label class="field"><span>Name</span><input type="text" name="name" required /></label>
      <label class="field"><span>Price (UGX)</span><input type="number" name="price" min="0" required /></label>
      <label class="field"><span>Category</span>
        <select name="categoryId">
          <% categories.forEach((c) => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
        </select>
      </label>
      <label class="field"><span>Image URL</span><input type="text" name="image" placeholder="/images/pizza.svg" /></label>
      <label class="field"><span>Description</span><input type="text" name="description" /></label>
      <button type="submit" class="btn btn-primary btn-block">Create Product</button>
    </form>
  </div>
</div>
