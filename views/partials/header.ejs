<header class="site-header">
  <nav class="navbar container">
    <a href="/" class="brand">
      <%- include('logo') %>
      <span class="brand-name">Rocket<em>Drop</em></span>
    </a>

    <button type="button" class="nav-toggle" id="navToggle" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>

    <ul class="nav-links" id="navLinks">
      <li><a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Home</a></li>
      <% if (currentUser) { %>
        <li><a href="/orders/my" class="<%= currentPath === '/orders/my' ? 'active' : '' %>">My Orders</a></li>
        <% if (currentUser.role === 'admin') { %>
          <li><a href="/admin" class="<%= currentPath.startsWith('/admin') ? 'active' : '' %>">Admin</a></li>
        <% } else if (currentUser.role === 'partner') { %>
          <li><a href="/partner/dashboard" class="<%= currentPath.startsWith('/partner/dashboard') ? 'active' : '' %>">Partner Dashboard</a></li>
        <% } else { %>
          <li><a href="/partner/apply" class="<%= currentPath === '/partner/apply' ? 'active' : '' %>">Become a Partner</a></li>
        <% } %>
      <% } %>
    </ul>

    <div class="nav-actions">
      <button type="button" class="search-trigger" id="searchTrigger" aria-label="Search products">
        <%- include('icon', { name: 'search', size: 18 }) %>
        <span>Search</span>
      </button>

      <% if (currentUser) { %>
        <div class="notif-wrap">
          <button type="button" class="notif-bell" id="notifBell" aria-label="Notifications">
            <%- include('icon', { name: 'bell', size: 20 }) %>
            <span class="notif-badge <%= unreadNotifications > 0 ? 'show' : '' %>" id="notifBadge"><%= unreadNotifications %></span>
          </button>
          <div class="notif-dropdown" id="notifDropdown">
            <div class="notif-dropdown-head">
              <strong>Notifications</strong>
              <a href="/notifications">View all</a>
            </div>
            <div class="notif-dropdown-list" id="notifDropdownList">
              <p class="notif-empty">Loading…</p>
            </div>
          </div>
        </div>
        <span class="nav-user">Hi, <%= currentUser.fullName.split(' ')[0] %></span>
        <a href="/auth/logout" class="btn btn-ghost btn-sm">Logout</a>
      <% } else { %>
        <a href="/auth/login" class="btn btn-ghost btn-sm">Sign In</a>
        <a href="/auth/register" class="btn btn-primary btn-sm">Sign Up</a>
      <% } %>
    </div>
  </nav>
</header>

<!-- SEARCH DRAWER -->
<div class="search-drawer" id="searchDrawer" aria-hidden="true">
  <div class="search-drawer-backdrop" id="searchBackdrop"></div>
  <div class="search-drawer-panel" role="dialog" aria-modal="true" aria-label="Search products">
    <div class="search-drawer-head">
      <h2>Search Products</h2>
      <button type="button" class="search-drawer-close" id="searchClose" aria-label="Close search">&times;</button>
    </div>
    <div class="search-drawer-input">
      <%- include('icon', { name: 'search', size: 20 }) %>
      <input type="search" id="searchDrawerInput" placeholder="Search pizza, milk, pharmacy, fashion…" autocomplete="off" />
    </div>
    <div class="search-drawer-results" id="searchDrawerResults">
      <p class="search-hint">Type to find products instantly across all categories.</p>
    </div>
  </div>
</div>

<button type="button" class="search-fab" id="searchFab" aria-label="Open search">
  <%- include('icon', { name: 'search', size: 22 }) %>
</button>

<div class="toast-stack" id="toastStack"></div>

<% if (flash) { %>
  <div class="flash-seed" data-type="<%= flash.type %>" data-message="<%= escapeHtml(flash.message) %>" hidden></div>
<% } %>
