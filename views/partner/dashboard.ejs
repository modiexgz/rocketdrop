<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="partner-body">
  <%- include('../partials/header') %>

  <main class="container partner-manage">
    <div class="partner-manage-head">
      <div>
        <p class="partner-manage-eyebrow">Partner Store</p>
        <h1><%= partner.businessName %></h1>
        <p class="muted"><%= partner.businessType %> · <%= partner.city || 'Uganda' %> · <%= partner.location %></p>
      </div>
      <span class="badge badge-partner-approved">Approved Partner</span>
    </div>

    <nav class="partner-tabs">
      <a href="/partner/dashboard?tab=categories" class="partner-tab <%= activeTab === 'categories' ? 'active' : '' %>">Categories</a>
      <a href="/partner/dashboard?tab=products" class="partner-tab <%= activeTab === 'products' ? 'active' : '' %>">Products</a>
    </nav>

    <div class="partner-manage-content">
      <%- include('../partials/dash/categories-panel', { categories, basePath: '/partner', activeTab }) %>
      <%- include('../partials/dash/products-panel', { products, categories, basePath: '/partner', activeTab }) %>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/dashboard.js"></script>
</body>
</html>
