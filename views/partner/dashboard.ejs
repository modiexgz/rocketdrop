<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="dash-body">
  <%- include('../partials/header') %>

  <main class="container section fade-in">
    <div class="dash-head">
      <div>
        <h1><%= partner.businessName %></h1>
        <p class="muted">Partner Dashboard · <%= partner.businessType %> · <%= partner.location || 'Uganda' %></p>
      </div>
      <span class="badge badge-partner-approved">Approved Partner</span>
    </div>

    <!-- NOTIFICATION BAR -->
    <% if (stats.pending > 0) { %>
      <div class="notif-bar slide-up">
        <span class="notif-bar-icon">🔔</span>
        <div class="notif-bar-items">
          <a href="#orders" data-tab-link="orders"><strong><%= stats.pending %></strong> order<%= stats.pending > 1 ? 's' : '' %> waiting for admin approval</a>
        </div>
      </div>
    <% } %>

    <!-- STATS -->
    <div class="stats-grid">
      <div class="stat-card reveal"><span class="stat-value"><%= stats.orders %></span><span class="stat-label">Orders</span></div>
      <div class="stat-card reveal"><span class="stat-value"><%= stats.products %></span><span class="stat-label">Products</span></div>
      <div class="stat-card reveal"><span class="stat-value"><%= stats.categories %></span><span class="stat-label">Categories</span></div>
      <div class="stat-card stat-accent reveal"><span class="stat-value">UGX <%= stats.revenue.toLocaleString() %></span><span class="stat-label">Revenue</span></div>
    </div>

    <!-- TABS -->
    <nav class="dash-tabs">
      <button data-tab="orders" class="active">Orders <% if (stats.pending > 0) { %><span class="tab-badge"><%= stats.pending %></span><% } %></button>
      <button data-tab="categories">Categories</button>
      <button data-tab="products">Products</button>
    </nav>

    <!-- ORDERS PANEL -->
    <section class="panel" id="orders">
      <div class="panel-head"><h2>Your Orders</h2></div>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th>#</th><th>Item</th><th>Customer</th><th>Qty</th><th>Total (UGX)</th><th>Payment</th><th>Status</th><th class="t-right">Actions</th></tr>
          </thead>
          <tbody>
            <% if (orders.length === 0) { %>
              <tr><td colspan="8" class="t-empty">No orders on your products yet.</td></tr>
            <% } %>
            <% orders.forEach((order) => { %>
              <tr>
                <td><%= order.id %></td>
                <td><strong><%= order.item %></strong></td>
                <td><%= order.userName %><br /><small class="t-muted"><%= order.userEmail %></small></td>
                <td><%= order.quantity %></td>
                <td><%= Number(order.total).toLocaleString() %></td>
                <td>
                  <span class="pay-chip pay-<%= order.payment.method %>"><%= paymentMethods[order.payment.method].label %></span><br />
                  <span class="badge badge-pay-<%= order.payment.status %>"><%= paymentStatusLabels[order.payment.status] %></span>
                </td>
                <td><span class="badge badge-<%= order.status %>"><%= statusLabels[order.status] %></span></td>
                <td class="t-right t-actions">
                  <% if (order.status === 'pending') { %>
                    <span class="t-muted">Awaiting admin approval</span>
                  <% } else if (order.status !== 'rejected' && order.status !== 'delivered') { %>
                    <form method="POST" action="/partner/orders/<%= order.id %>/stage" class="inline stage-form">
                      <select name="status" class="select-sm">
                        <option value="preparing" <%= order.status === 'preparing' ? 'selected' : '' %>>Preparing</option>
                        <option value="out_for_delivery" <%= order.status === 'out_for_delivery' ? 'selected' : '' %>>Out for Delivery</option>
                        <option value="delivered">Delivered</option>
                      </select>
                      <button class="btn btn-ghost btn-sm">Update Stage</button>
                    </form>
                  <% } else { %>
                    <span class="t-muted">—</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>

    <!-- CATEGORIES + PRODUCTS PANELS (shared partials) -->
    <%- include('../partials/dash/categories-panel', { categories, basePath: '/partner' }) %>
    <%- include('../partials/dash/products-panel', { products, categories, basePath: '/partner' }) %>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/dashboard.js"></script>
</body>
</html>
