<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Orders Report · RocketDrop</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: #fff;
      color: #111;
      padding: 32px;
    }
    .report-head { text-align: center; margin-bottom: 24px; }
    .report-head h1 { font-size: 22px; letter-spacing: -0.02em; }
    .report-head p { color: #666; font-size: 12px; margin-top: 4px; }
    .report-actions {
      display: flex; gap: 10px; justify-content: center; margin-bottom: 28px;
    }
    .report-actions a, .report-actions button {
      padding: 10px 18px; border-radius: 10px; border: 1px solid #ddd;
      background: #f7f7f8; color: #111; font-size: 13px; font-weight: 600;
      cursor: pointer; text-decoration: none; transition: all 0.2s;
    }
    .report-actions a:hover, .report-actions button:hover { background: #ff5722; color: #fff; border-color: #ff5722; }
    table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
    th {
      background: #ff5722; color: #fff; text-align: left;
      padding: 10px 12px; font-weight: 600;
    }
    td { padding: 9px 12px; border-bottom: 1px solid #eee; vertical-align: top; }
    tr:nth-child(even) td { background: #faf7f5; }
    .t-muted { color: #777; font-size: 11.5px; }
    .report-foot { margin-top: 20px; text-align: center; color: #888; font-size: 11px; }
    @media print {
      .report-actions { display: none; }
      body { padding: 0; }
    }
  </style>
</head>
<body>
  <div class="report-head">
    <h1>RocketDrop — Orders Report</h1>
    <p>Generated: <%= generatedAt %> · Total orders: <%= orders.length %></p>
  </div>

  <div class="report-actions">
    <button onclick="window.print()">🖨 Print</button>
    <a href="/admin/reports/orders.pdf?download=1">⬇ Download PDF</a>
    <a href="/admin/reports/orders.xlsx">⬇ Download Excel</a>
    <a href="/admin">← Back to Dashboard</a>
  </div>

  <table>
    <thead>
      <tr>
        <th>#</th><th>Item</th><th>Customer</th><th>Qty</th><th>Total (UGX)</th>
        <th>Status</th><th>Payment</th><th>Delivery Man</th><th>Date</th>
      </tr>
    </thead>
    <tbody>
      <% orders.forEach((o) => { %>
        <tr>
          <td><%= o.id %></td>
          <td><strong><%= o.item %></strong></td>
          <td><%= o.userName || '—' %><br /><span class="t-muted"><%= o.userEmail %></span></td>
          <td><%= o.quantity || 1 %></td>
          <td><%= Number(o.total || 0).toLocaleString() %></td>
          <td><%= statusLabels[o.status] || o.status %></td>
          <td><%= paymentLabel(o) %></td>
          <td><%= o.deliveryMan ? `${o.deliveryMan.name} (${o.deliveryMan.phone})` : '—' %></td>
          <td><%= new Date(o.createdAt).toLocaleString('en-UG') %></td>
        </tr>
      <% }) %>
      <% if (orders.length === 0) { %>
        <tr><td colspan="9" style="text-align:center; color:#888; padding: 24px;">No orders recorded.</td></tr>
      <% } %>
    </tbody>
  </table>

  <p class="report-foot">RocketDrop Delivery · Orders Report</p>
</body>
</html>
