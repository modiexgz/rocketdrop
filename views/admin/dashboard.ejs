<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="admin-body">
  <div class="admin-shell">
    <aside class="admin-sidebar">
      <div class="admin-sidebar-brand">
        <%- include('../partials/logo') %>
        <div>
          <strong>RocketDrop</strong>
          <span>Admin Console</span>
        </div>
      </div>

      <nav class="admin-sidebar-nav">
        <a href="/admin" class="admin-nav-item <%= activeTab === 'overview' ? 'active' : '' %>">
          <img src="/icons/document.svg" alt="" class="admin-nav-icon" />
          <span>Overview</span>
        </a>
        <a href="/admin?tab=orders" class="admin-nav-item <%= activeTab === 'orders' ? 'active' : '' %>">
          <img src="/icons/order.svg" alt="" class="admin-nav-icon" />
          <span>Orders</span>
          <% if (stats.pendingOrders || stats.pendingPayments) { %>
            <span class="nav-badge"><%= (stats.pendingOrders || 0) + (stats.pendingPayments || 0) %></span>
          <% } %>
        </a>
        <a href="/admin?tab=categories" class="admin-nav-item <%= activeTab === 'categories' ? 'active' : '' %>">
          <img src="/icons/search.svg" alt="" class="admin-nav-icon" />
          <span>Categories</span>
        </a>
        <a href="/admin?tab=products" class="admin-nav-item <%= activeTab === 'products' ? 'active' : '' %>">
          <img src="/icons/delivery.svg" alt="" class="admin-nav-icon" />
          <span>Products</span>
        </a>
        <a href="/admin?tab=partners" class="admin-nav-item <%= activeTab === 'partners' ? 'active' : '' %>">
          <img src="/icons/partner.svg" alt="" class="admin-nav-icon" />
          <span>Partners</span>
          <% if (stats.pendingPartners) { %><span class="nav-badge"><%= stats.pendingPartners %></span><% } %>
        </a>
        <a href="/admin?tab=users" class="admin-nav-item <%= activeTab === 'users' ? 'active' : '' %>">
          <img src="/icons/document.svg" alt="" class="admin-nav-icon" />
          <span>Users</span>
        </a>
      </nav>

      <div class="admin-sidebar-foot">
        <a href="/admin/reports/orders" class="admin-nav-item muted-link" target="_blank">Orders Report</a>
        <a href="/" class="admin-nav-item muted-link">View Storefront</a>
        <a href="/auth/logout" class="admin-nav-item muted-link">Sign Out</a>
      </div>
    </aside>

    <div class="admin-main">
      <header class="admin-topbar">
        <div>
          <h1><%= {
            overview: 'Analytics Overview',
            orders: 'Order Management',
            categories: 'Categories',
            products: 'Products',
            partners: 'Partner Applications',
            users: 'Users'
          }[activeTab] || 'Admin Console' %></h1>
          <p class="muted">Signed in as <%= currentUser.fullName %> · <%= currentUser.email %></p>
        </div>
        <div class="admin-topbar-actions">
          <span class="admin-role-badge">Administrator</span>
        </div>
      </header>

      <main class="admin-content">
        <% if (flash) { %>
          <div class="flash-seed" data-type="<%= flash.type %>" data-message="<%= escapeHtml(flash.message) %>" hidden></div>
        <% } %>

        <%- include('../partials/dash/overview-panel', { orders, stats, statusLabels, activeTab }) %>
        <%- include('../partials/dash/orders-panel', { orders, statusLabels, paymentMethods, paymentStatusLabels, activeTab }) %>
        <%- include('../partials/dash/categories-panel', { categories, basePath: '/admin', activeTab }) %>
        <%- include('../partials/dash/products-panel', { products, categories, basePath: '/admin', activeTab }) %>
        <%- include('../partials/dash/partners-panel', { partners, activeTab }) %>

        <section class="panel <%= activeTab === 'users' ? 'active' : '' %>" id="users">
          <div class="panel-head"><h2>Users</h2></div>
          <div class="table-wrap">
            <table class="table">
              <thead>
                <tr><th>#</th><th>Full Name</th><th>Email</th><th>Phone</th><th>Role</th><th>Joined</th></tr>
              </thead>
              <tbody>
                <% users.forEach((u) => { %>
                  <tr>
                    <td><%= u.id %></td>
                    <td><strong><%= u.fullName %></strong></td>
                    <td><%= u.email %></td>
                    <td><%= u.phone %></td>
                    <td><span class="badge badge-role-<%= u.role %>"><%= u.role %></span></td>
                    <td class="t-muted"><%= new Date(u.createdAt).toLocaleDateString('en-UG') %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
      </main>
    </div>
  </div>

  <div class="toast-stack" id="toastStack"></div>
  <script src="/js/main.js"></script>
  <script src="/js/dashboard.js"></script>
</body>
</html>
