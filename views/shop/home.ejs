<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="home-page">
  <%- include('../partials/header') %>

  <main>
    <!-- HERO -->
    <section class="landing-hero">
      <div class="landing-hero-bg"></div>
      <div class="container landing-hero-grid">
        <div class="landing-hero-copy slide-up">
          <p class="landing-eyebrow">Uganda's fastest delivery network</p>
          <h1>Everything you need,<br /><span>delivered in minutes.</span></h1>
          <p class="landing-lead">Food, grocery, pharmacy and fashion — order from trusted partners and track every step until it reaches your door.</p>
          <div class="landing-cta">
            <button type="button" class="btn btn-primary btn-lg" id="heroSearchBtn">Search Products</button>
            <% if (currentUser) { %>
              <a href="/orders/my" class="btn btn-ghost btn-lg">Track Orders</a>
            <% } else { %>
              <a href="/auth/register" class="btn btn-ghost btn-lg">Get Started</a>
            <% } %>
          </div>
          <div class="landing-pay-row">
            <img src="/icons/payment.svg" alt="" class="ui-icon" width="18" height="18" />
            <span class="pay-chip pay-airtel">Airtel Money</span>
            <span class="pay-chip pay-mtn">MTN Mobile Money</span>
            <span class="pay-chip pay-cod">Cash on Delivery</span>
          </div>
        </div>
        <div class="landing-hero-visual slide-up delay-1">
          <div class="landing-orbit">
            <div class="landing-orbit-center"><%- include('../partials/logo') %></div>
            <% if (products[0]) { %><img src="<%= products[0].image %>" class="orbit-item o1" alt="" /><% } %>
            <% if (products[1]) { %><img src="<%= products[1].image %>" class="orbit-item o2" alt="" /><% } %>
            <% if (products[2]) { %><img src="<%= products[2].image %>" class="orbit-item o3" alt="" /><% } %>
            <% if (products[3]) { %><img src="<%= products[3].image %>" class="orbit-item o4" alt="" /><% } %>
          </div>
        </div>
      </div>
    </section>

    <!-- STATS -->
    <section class="landing-stats container reveal">
      <div class="landing-stat"><strong>20+</strong><span>Products ready to order</span></div>
      <div class="landing-stat"><strong>4</strong><span>Delivery categories</span></div>
      <div class="landing-stat"><strong>24/7</strong><span>Order tracking</span></div>
      <div class="landing-stat"><strong>UGX</strong><span>Mobile money supported</span></div>
    </section>

    <!-- CATEGORIES -->
    <section class="section container" id="categories">
      <div class="section-head">
        <h2>Shop by category</h2>
        <p>Browse curated collections from RocketDrop and verified partners.</p>
      </div>
      <div class="grid grid-4">
        <% categories.forEach((cat, i) => { %>
          <a href="/categories/<%= cat.id %>" class="card category-card reveal" style="--d: <%= i * 0.08 %>s">
            <div class="card-media"><img src="<%= cat.image %>" alt="<%= cat.name %>" loading="lazy" /></div>
            <div class="card-body">
              <h3><%= cat.name %></h3>
              <p><%= cat.description %></p>
              <span class="card-link">Browse collection</span>
            </div>
          </a>
        <% }) %>
      </div>
    </section>

    <!-- PRODUCTS -->
    <section class="section container landing-products" id="products">
      <div class="section-head section-head-row">
        <div>
          <h2><%= query ? `Results for "${query}"` : 'Trending now' %></h2>
          <p><%= query ? `${products.length} item(s) found` : 'Popular picks customers love this week.' %></p>
        </div>
        <button type="button" class="btn btn-ghost" id="productsSearchBtn">Open search</button>
      </div>

      <% if (products.length === 0) { %>
        <div class="empty-state">
          <p>Nothing matched your search. Try another keyword or browse categories.</p>
          <button type="button" class="btn btn-primary" id="emptySearchBtn">Search again</button>
        </div>
      <% } else { %>
        <div class="grid grid-4">
          <% products.forEach((product, i) => { %>
            <div class="card product-card reveal" style="--d: <%= (i % 8) * 0.06 %>s">
              <div class="card-media"><img src="<%= product.image %>" alt="<%= product.name %>" loading="lazy" /></div>
              <div class="card-body">
                <h3><%= product.name %></h3>
                <p class="price">UGX <%= Number(product.price).toLocaleString() %></p>
                <% if (currentUser) { %>
                  <a href="/orders/new/<%= product.id %>" class="btn btn-primary btn-block">Order Now</a>
                <% } else { %>
                  <a href="/auth/login" class="btn btn-primary btn-block">Sign in to Order</a>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>

    <!-- HOW IT WORKS -->
    <section class="section container">
      <div class="section-head">
        <h2>How RocketDrop works</h2>
        <p>From browse to doorstep in four simple steps.</p>
      </div>
      <div class="steps-grid">
        <article class="step-card reveal">
          <img src="/icons/search.svg" alt="" class="step-icon" />
          <h3>Search &amp; order</h3>
          <p>Find what you need using the quick search drawer — always accessible from the header.</p>
        </article>
        <article class="step-card reveal">
          <img src="/icons/payment.svg" alt="" class="step-icon" />
          <h3>Pay your way</h3>
          <p>Use Airtel Money, MTN MoMo or pay cash on delivery. Mobile money is confirmed by our team.</p>
        </article>
        <article class="step-card reveal">
          <img src="/icons/success.svg" alt="" class="step-icon" />
          <h3>Get approved</h3>
          <p>We review your order and send you the delivery person's name, phone and location.</p>
        </article>
        <article class="step-card reveal">
          <img src="/icons/delivery.svg" alt="" class="step-icon" />
          <h3>Track delivery</h3>
          <p>Follow live stages from preparing to out for delivery until it arrives at your door.</p>
        </article>
      </div>
    </section>

    <!-- PARTNER CTA -->
    <section class="section container">
      <div class="cta-banner reveal">
        <div>
          <h2>Run a restaurant, shop or pharmacy?</h2>
          <p>Apply to become a RocketDrop partner. Once approved, manage your own menu, categories and orders from a dedicated dashboard.</p>
        </div>
        <a href="<%= currentUser ? '/partner/apply' : '/auth/register' %>" class="btn btn-light">Become a Partner</a>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
