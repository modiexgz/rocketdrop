<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="home-page">
  <%- include('../partials/header') %>

  <main>
    <!-- HERO -->
    <section class="store-hero">
      <div class="store-hero-bg"></div>
      <div class="container store-hero-inner">
        <div class="store-hero-copy slide-up">
          <p class="store-hero-eyebrow">Delivered across Uganda</p>
          <h1>Order food, groceries,<br />pharmacy &amp; fashion.</h1>
          <p class="store-hero-lead">Browse by category, pay with Airtel Money, MTN MoMo or cash on delivery — and track every step to your door.</p>
          <div class="store-hero-search">
            <button type="button" class="store-search-btn" id="heroSearchBtn">
              <%- include('../partials/icon', { name: 'search', size: 20 }) %>
              <span>Search products, meals, medicine…</span>
            </button>
          </div>
          <div class="store-hero-chips">
            <span class="pay-chip pay-airtel">Airtel Money</span>
            <span class="pay-chip pay-mtn">MTN MoMo</span>
            <span class="pay-chip pay-cod">Cash on Delivery</span>
          </div>
        </div>
        <div class="store-hero-art slide-up delay-1" aria-hidden="true">
          <div class="store-hero-card store-hero-card-a">
            <% if (products[0]) { %><img src="<%= products[0].image %>" alt="" /><% } %>
          </div>
          <div class="store-hero-card store-hero-card-b">
            <% if (products[1]) { %><img src="<%= products[1].image %>" alt="" /><% } %>
          </div>
          <div class="store-hero-card store-hero-card-c">
            <% if (products[2]) { %><img src="<%= products[2].image %>" alt="" /><% } %>
          </div>
        </div>
      </div>
    </section>

    <!-- CATEGORIES -->
    <section class="section container store-categories" id="categories">
      <div class="section-head store-section-head">
        <div>
          <p class="section-eyebrow">What do you need?</p>
          <h2>Shop by category</h2>
          <p>Four dedicated departments — each with its own curated selection.</p>
        </div>
      </div>
      <div class="category-showcase">
        <% categories.forEach((cat, i) => { %>
          <a href="/categories/<%= cat.id %>" class="category-tile category-tile-<%= cat.theme %> reveal" style="--d: <%= i * 0.1 %>s">
            <div class="category-tile-media">
              <img src="<%= cat.image %>" alt="<%= cat.name %>" loading="lazy" />
            </div>
            <div class="category-tile-body">
              <span class="category-tile-tag"><%= cat.theme %></span>
              <h3><%= cat.name %></h3>
              <p><%= cat.description %></p>
              <span class="category-tile-meta"><%= cat.productCount %> item<%= cat.productCount === 1 ? '' : 's' %> · Browse now →</span>
            </div>
          </a>
        <% }) %>
      </div>
    </section>

    <!-- PRODUCTS -->
    <section class="section container store-products" id="products">
      <div class="section-head section-head-row">
        <div>
          <p class="section-eyebrow">Popular picks</p>
          <h2><%= query ? `Results for "${query}"` : 'Trending now' %></h2>
          <p><%= query ? `${products.length} item(s) found` : 'Fresh favourites customers order every day.' %></p>
        </div>
        <button type="button" class="btn btn-ghost" id="productsSearchBtn">Open search</button>
      </div>

      <% if (products.length === 0) { %>
        <div class="empty-state">
          <p>Nothing matched your search. Try another keyword or browse categories above.</p>
          <button type="button" class="btn btn-primary" id="emptySearchBtn">Search again</button>
        </div>
      <% } else { %>
        <div class="product-grid">
          <% products.slice(0, 12).forEach((product, i) => { %>
            <article class="product-tile reveal" style="--d: <%= (i % 8) * 0.05 %>s">
              <a href="/categories/<%= product.categoryId %>" class="product-tile-media">
                <img src="<%= product.image %>" alt="<%= product.name %>" loading="lazy" />
              </a>
              <div class="product-tile-body">
                <h3><%= product.name %></h3>
                <p class="price">UGX <%= Number(product.price).toLocaleString() %></p>
                <% if (canOrder) { %>
                  <a href="/orders/new/<%= product.id %>" class="btn btn-primary btn-block">Order Now</a>
                <% } else if (currentUser) { %>
                  <span class="staff-order-note muted">Staff accounts cannot place customer orders.</span>
                <% } else { %>
                  <a href="/auth/login" class="btn btn-primary btn-block">Sign in to Order</a>
                <% } %>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>

    <!-- HOW IT WORKS -->
    <section class="section container store-steps">
      <div class="section-head">
        <p class="section-eyebrow">Simple process</p>
        <h2>How RocketDrop works</h2>
      </div>
      <div class="steps-grid">
        <article class="step-card reveal">
          <img src="/icons/search.svg" alt="" class="step-icon" />
          <h3>Search &amp; order</h3>
          <p>Find what you need using the quick search drawer — always accessible from the header.</p>
        </article>
        <article class="step-card reveal">
          <img src="/icons/payment.svg" alt="" class="step-icon" />
          <h3>Pay your way</h3>
          <p>Use Airtel Money, MTN MoMo or pay cash on delivery.</p>
        </article>
        <article class="step-card reveal">
          <img src="/icons/success.svg" alt="" class="step-icon" />
          <h3>Get approved</h3>
          <p>We review your order and assign a delivery person with contact details.</p>
        </article>
        <article class="step-card reveal">
          <img src="/icons/delivery.svg" alt="" class="step-icon" />
          <h3>Track delivery</h3>
          <p>Follow live stages from preparing to out for delivery until it arrives.</p>
        </article>
      </div>
    </section>

    <% if (!currentUser || currentUser.role === 'user') { %>
      <section class="section container">
        <div class="cta-banner reveal">
          <div>
            <h2>Run a restaurant, shop or pharmacy?</h2>
            <p>Apply to become a RocketDrop partner. Once approved, manage your categories and products from your account.</p>
          </div>
          <a href="<%= currentUser ? '/partner/apply' : '/auth/register' %>" class="btn btn-light">Become a Partner</a>
        </div>
      </section>
    <% } %>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
